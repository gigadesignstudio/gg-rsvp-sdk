{
  "name": "gg-rsvp-sdk",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK to integrate RSVP forms into external websites",
  "repository": {
    "type": "git",
    "url": "https://github.com/gigadesignstudio/gg-rsvp-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "dev": "tsup --watch"
  },
  "keywords": [
    "rsvp",
    "events",
    "sdk",
    "forms"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
